# Browser test image: Microsoft's Playwright image (Ubuntu, Chromium + system
# deps preinstalled) plus Leaf's Python deps. Test-only — the app image
# (Containerfile) stays browser-free. The repo is bind-mounted at /repo at run
# time, so the image only needs rebuilding when dependencies change.
#
#   ./run.sh e2e            # build (cached) and run tests/e2e
#
# Keep the playwright pip version in lockstep with the image tag: the Python
# package only works with the browser build that ships in the matching image.
FROM mcr.microsoft.com/playwright/python:v1.63.0-noble

COPY src/requirements.txt /tmp/requirements.txt
RUN pip install --break-system-packages --no-cache-dir \
      -r /tmp/requirements.txt pytest playwright==1.63.0

WORKDIR /repo
CMD ["python3", "-m", "pytest", "tests/e2e", "-v"]
