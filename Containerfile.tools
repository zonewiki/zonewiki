# Tools image: what checking Zone needs beyond the app itself. Microsoft's
# Playwright image (Ubuntu, Chromium + system deps preinstalled) plus Go,
# which builds and tests the server, the tests' Python packages
# (tests/requirements.txt: pytest, pytest-xdist, which runs them in
# parallel), Node for the tasks-core tests, and gitleaks for the secret scan.
# Test-only — the app image (Containerfile) stays browser-free. The repo is
# bind-mounted at /repo at run time, so the image only needs rebuilding when
# dependencies change.
#
#   ./run.sh test           # build (cached), go vet + go test, the API tests
#   ./run.sh e2e            # the browser tests + tasks-core
#   ./run.sh leaks          # scan the git history for secrets
#
# Keep the playwright pin (tests/requirements.txt) in lockstep with the image
# tag: the Python package only works with the browser build that ships in
# the matching image.
# By digest too (the tag's multi-arch index): change it with the tag.
FROM mcr.microsoft.com/playwright/python:v1.63.0-noble@sha256:72bd171a9ffc2b4b59532aaa6210e21014d07093120dc25528870c0b840da1f0

# Node runs tests/test_tasks_core.py (the pure tasks logic in tasks-core.js);
# curl fetches gitleaks below; pngquant compresses the README's screenshots
# (docs/screenshots/make_screenshots.py); gcc and libc6-dev are what Go's race
# detector takes (go test -race needs cgo: ./run.sh test).
RUN apt-get update && apt-get install -y --no-install-recommends nodejs git curl ca-certificates pngquant gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*

# gitleaks, a pinned release checked against its published checksums. To
# update it, change the version and both sums (gitleaks_<v>_checksums.txt).
# TARGETARCH has no default, as in Containerfile: a default wins over the one
# the builder sets, and an arm64 machine got amd64's gitleaks and Go. Where
# the builder doesn't set it, the container's own architecture is it.
ARG TARGETARCH
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256_X64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG GITLEAKS_SHA256_ARM64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
RUN TARGETARCH=${TARGETARCH:-$(dpkg --print-architecture)} \
 && case "$TARGETARCH" in \
      amd64) arch=x64 sum=$GITLEAKS_SHA256_X64 ;; \
      arm64) arch=arm64 sum=$GITLEAKS_SHA256_ARM64 ;; \
      *) echo "no gitleaks build for $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -sSfL -o /tmp/gitleaks.tgz \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${arch}.tar.gz" \
 && echo "$sum  /tmp/gitleaks.tgz" | sha256sum -c - \
 && tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks \
 && rm /tmp/gitleaks.tgz

# Go builds and tests the server (go/), a pinned release checked against its
# published checksum (go.dev/dl), the same as Containerfile's. To update it,
# change the version and both sums in both files.
ARG GO_VERSION=1.27.3
ARG GO_SHA256_AMD64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
ARG GO_SHA256_ARM64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
RUN TARGETARCH=${TARGETARCH:-$(dpkg --print-architecture)} \
 && case "$TARGETARCH" in \
      amd64) sum=$GO_SHA256_AMD64 ;; \
      arm64) sum=$GO_SHA256_ARM64 ;; \
      *) echo "no Go build for $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -sSfL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" \
 && echo "$sum  /tmp/go.tgz" | sha256sum -c - \
 && tar -xzf /tmp/go.tgz -C /usr/local \
 && rm /tmp/go.tgz
# Without cgo, as before the image had a C compiler: the server the tests
# build searches by keywords (go/embed_nocgo.go), and so does CI's. Only the
# race detector's run turns it on (run.sh).
ENV PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=local CGO_ENABLED=0
# The server's modules (go.sum checks them), so a test run fetches nothing;
# with the root's go.mod, the module of Zone's own files (zonefiles.go),
# which go/go.mod takes from ../.
COPY go.mod /tmp/gomod/
COPY go/go.mod go/go.sum /tmp/gomod/go/
RUN cd /tmp/gomod/go && go mod download && rm -rf /tmp/gomod

COPY tests/requirements.txt /tmp/requirements.txt
RUN pip install --break-system-packages --no-cache-dir -r /tmp/requirements.txt

WORKDIR /repo
CMD ["python3", "-m", "pytest", "tests/e2e", "tests/test_tasks_core.py", "-v"]
